PORT=5001
NODE_ENV=development
# MongoDB connection URI (Paste your MongoDB Atlas connection string here or use local MongoDB)
# Example MongoDB Atlas URI: mongodb+srv://username:password@cluster0.mongodb.net/gaxinmart?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gaxinmart

# JWT Secret for Admin authentication
JWT_SECRET=gaxinmart_jwt_secret_key_2026_secure

# Default Admin Credentials
ADMIN_EMAIL=admin@gaxinmart.com
ADMIN_PASSWORD=gaxinmart3140

# Cloudinary credentials for product image & banner upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Application URL
CLIENT_URL=https://www.gaxinmart.shop
